    "hubot-scripts",
    "nic",
    "whois",
    "chile",
    "dominios",
    "slack"
  ],
  "author": "Jorge Epuñan <juanbrujo@gmail.com> (http://www.csslab.cl)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/juanbrujo/hubot-nic_chile/issues"
  },
  "homepage": "https://github.com/juanbrujo/hubot-nic_chile#readme",
  "scripts": {
    "test": "node --test test/nic.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^17.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
